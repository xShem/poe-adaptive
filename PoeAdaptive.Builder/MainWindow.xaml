<Window x:Class="PoeAdaptive.Builder.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="PoeAdaptive Builder 0.2.0" Width="820" Height="640" MinWidth="700" MinHeight="540" WindowStartupLocation="CenterScreen" Background="#171C25" Foreground="#E5EAF2">
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock Text="PoeAdaptive Builder" FontSize="26" FontWeight="Bold"/><TextBlock Text="Windows 11 x64 · приложение и Builder с включённым .NET Runtime" Margin="0,6,0,20" Foreground="#AEBACE"/></StackPanel>
  <DockPanel Grid.Row="1" Margin="0,0,0,12"><Button x:Name="SourceButton" DockPanel.Dock="Right" Content="Исходники…" Click="ChooseSource" Padding="12,7" Margin="8,0,0,0"/><TextBox x:Name="Source" Padding="8" TextChanged="SourceChanged"/></DockPanel>
  <DockPanel Grid.Row="2" Margin="0,0,0,12"><Button x:Name="OutputButton" DockPanel.Dock="Right" Content="Результат…" Click="ChooseOutput" Padding="12,7" Margin="8,0,0,0"/><TextBox x:Name="Output" Padding="8"/></DockPanel>
  <StackPanel Grid.Row="3" Margin="0,0,0,12"><TextBlock x:Name="ProjectVersion" Text="Версия проекта: выберите исходники"/><TextBlock x:Name="Sdk" Text="Проверка SDK…" TextWrapping="Wrap" Margin="0,5,0,0"/><CheckBox x:Name="Offline" Content="Повторная сборка из кэша (без загрузок)" Foreground="#E5EAF2" Margin="0,10,0,0"/></StackPanel>
  <TextBlock Grid.Row="4" x:Name="Stage" Text="Готов к работе" Margin="0,0,0,8" TextWrapping="Wrap"/>
  <TextBox Grid.Row="5" x:Name="Log" Background="#0E1219" Foreground="#C5D2E5" FontFamily="Consolas" IsReadOnly="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Padding="10"/>
  <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0"><Button x:Name="OpenButton" Content="Открыть результат" Click="OpenResult" IsEnabled="False" Padding="12,8" Margin="0,0,8,0"/><Button x:Name="CancelButton" Content="Отмена" Click="Cancel" IsEnabled="False" Padding="12,8" Margin="0,0,8,0"/><Button x:Name="BuildButton" Content="Собрать" Click="BuildClick" Padding="22,8"/></StackPanel>
 </Grid>
</Window>
