<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>PoeRedux</RootNamespace>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>..\icon.ico</ApplicationIcon>
    <Version>0.2.0</Version>
    <AssemblyName>PoeAdaptive</AssemblyName>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <!-- Disables CET / shadow-stack on the exe to avoid a fatal startup crash (0x80131506) caused by the native non-CET-aware oo2core.dll. See issue #29. -->
    <CETCompat>false</CETCompat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
    <!-- <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile> -->
  </PropertyGroup>
  
  <ItemGroup>
    <None Remove="oo2core.dll" />
    <ProjectReference Include="../PoeAdaptive.Engine/PoeAdaptive.Engine.csproj" />
    <Compile Remove="Patches/**/*.cs;Patches2/**/*.cs;Models/ColorModsOption.cs;Services/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="../README.md;../LICENSE;../LICENSE-AGPL-3.0.txt;../THIRD_PARTY.md;../rules.example.json"
             Link="%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  
  <ItemGroup>
  </ItemGroup>

</Project>
