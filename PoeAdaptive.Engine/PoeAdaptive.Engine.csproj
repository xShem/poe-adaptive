<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Version>0.2.0</Version>
    <SourceRevisionId Condition="'$(GITHUB_SHA)' != ''">$(GITHUB_SHA)</SourceRevisionId>
  </PropertyGroup>
  <ItemGroup Condition="'$(SourceRevisionId)' != ''">
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SourceCommit</_Parameter1>
      <_Parameter2>$(SourceRevisionId)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../PoeAdaptive.Core/PoeAdaptive.Core.csproj" />
    <PackageReference Include="LibGGPK3.LibBundle3" Version="[2.7.5]" />
    <PackageReference Include="LibGGPK3.LibBundledGGPK3" Version="[2.7.5]" />
    <Compile Include="../PoeRedux/Patches/**/*.cs" LinkBase="Patches" />
    <Compile Include="../PoeRedux/Patches2/**/*.cs" LinkBase="Patches2" />
    <Compile Include="../PoeRedux/Models/ColorModsOption.cs" Link="Models/ColorModsOption.cs" />
    <Compile Include="../PoeRedux/Services/*.cs" LinkBase="Services" />
  </ItemGroup>
</Project>
